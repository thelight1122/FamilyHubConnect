# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local to version control.

# Base URL for the FamilyHubConnect API
VITE_API_BASE_URL=https://your-api.example.com

# Supabase client settings for the production app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Keep false or unset for production until a real identity provider is wired.
# Development builds automatically use the local mock auth flow.
VITE_ENABLE_MOCK_AUTH=false
